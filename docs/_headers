# Nagłówki dla hostingu statycznego (Cloudflare Pages, Netlify, Vercel).
# Plik jest kopiowany do dist/ przez tools/make_dist.py.
#
# Aplikacja nie łączy się z niczym na zewnątrz — CSP to wymusza.
/*:
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; form-action 'none'; base-uri 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=()
  Service-Worker-Allowed: /

# Service worker i manifest muszą być zawsze świeże
/sw.js:
  Cache-Control: no-cache

/manifest.webmanifest:
  Cache-Control: no-cache
  Content-Type: application/manifest+json

# Ikony i grafiki mogą być cache'owane długo
/*.png:
  Cache-Control: public, max-age=604800

/*.svg:
  Cache-Control: public, max-age=604800

/*.ico:
  Cache-Control: public, max-age=604800
